var totalNumbers = function(digits) {
     let f = digits.reduce((a, c) => (a[c] = (a[c] ?? 0) + 1, a), []);
    let res = 0;

    for (let i = 1; i < 10; i++)
        for (let j = 0; j < 10; j++)
            for (let k = 0; k < 9; k += 2)
                res += (f[i] ?? 0) > 0 &&
                       (f[j] ?? 0) > (i === j) &&
                       (f[k] ?? 0) > (i === k) + (j === k);

    return res;
};
