var numberOfSpecialChars = function(word) {
    let low = new Array(26).fill(false);
    let up = new Array(26).fill(false);

    for (let c of word) {
        // Lowercase character
        if (c >= 'a' && c <= 'z') {
            low[c.charCodeAt(0) - 'a'.charCodeAt(0)] = true;
